# Discord Developer Portal: bot token and application id
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# PostgreSQL recommended. SQLite is useful for local testing only.
DATABASE_URL=postgresql+asyncpg://vpi:replace-with-a-long-random-password@127.0.0.1:5432/vpi_bot
POSTGRES_DB=vpi_bot
POSTGRES_USER=vpi
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST_PORT=5432

# Optional single-server bootstrap. Leave blank to bind through /setup.
AUTHORIZED_GUILD_ID=

# OpenAI-compatible API. Keep secrets only in environment variables.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.25
AI_MAX_TOKENS=1800
AI_TIMEOUT_SECONDS=45

# Scheduler and game defaults
GAME_TIMEZONE=Europe/Saratov
GLOBAL_DAILY_POST_LIMIT=3
RESOURCE_TICK_HOURS=4
VERDICT_MODE=automatic
LOG_LEVEL=INFO
